# Copy to .env and adjust. Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://autoplan:autoplan_dev@localhost:5432/autoplan?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
# Browser origin allowed to call the API and open sockets (the Vite dev server).
WEB_ORIGIN="http://localhost:5173"
# Week plan: 1 production week + this many packing-material weeks.
PM_WEEKS=4
# Automatic week plan every Friday 05:00 in this time zone.
AUTO_WEEK_PLAN=on
TZ_PLANT="Asia/Kolkata"
